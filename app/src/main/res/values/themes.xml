<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KeySwipe" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- ショートカット表のキー表示チップ -->
    <style name="KeyChip">
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/key_chip_bg</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="KeyDesc">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>
</resources>
