<!-- テーマアイコン(Android 13+)用のモノクロ版。
     システムが単色で塗るため、ガラスキーキャップの輪郭と
     双方向のスワイプ矢印だけのシルエットにする。
     座標は artwork/icon.svg（glassneon）の天面・矢印に合わせてある。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- キーキャップの輪郭（天面 x143..369 / y156..330 / rx42） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="20"
        android:pathData="M185,156 L327,156 A42,42 0 0 1 369,198 L369,288 A42,42 0 0 1 327,330 L185,330 A42,42 0 0 1 143,288 L143,198 A42,42 0 0 1 185,156 Z" />

    <!-- 双方向スワイプ矢印（軸） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="26"
        android:strokeLineCap="round"
        android:pathData="M172,243 L340,243" />

    <!-- 左の鏃 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="26"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M214,201 L172,243 L214,285" />

    <!-- 右の鏃 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="26"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M298,201 L340,243 L298,285" />
</vector>
